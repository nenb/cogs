{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.invalid/schemas/stage2-workload-final-pin-v1.json",
  "title": "Externally reviewed Stage 2 package and exact runtime production pin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "candidate_contract_sha256",
    "candidate_result_sha256",
    "runtime_closure",
    "package_identity",
    "reproductions",
    "promotion"
  ],
  "properties": {
    "version": {
      "const": "cogs.stage2-workload-final-pin/v1"
