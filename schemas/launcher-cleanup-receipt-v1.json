{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.local/schemas/launcher-cleanup-receipt-v1.json",
  "title": "Cogs development launcher worker cleanup receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stateId",
    "sourceRevision",
    "startupDigest",
    "childPid",
    "childPidIdentity",
    "outcome",
    "closedResources"
  ],
  "properties": {
    "version": { "const": "cogs.dev-launcher-cleanup-receipt/v1" },
    "stateId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "startupDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "childPid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "childPidIdentity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "outcome": { "const": "retired" },
    "closedResources": {
      "const": [
        "api",
        "pi",
        "lifecycle",
        "egress",
        "ssh",
        "envoy-binary",
        "listener-reservation",
        "telemetry",
        "local-fixture",
        "otlp",
        "openbao",
        "api-token-holder",
        "runtime-roots",
        "host-skills",
        "ssh-key"
      ]
    }
  }
}
