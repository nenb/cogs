{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.invalid/schemas/stage2-phase-b-qualification-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stage",
    "authority",
    "qualified",
    "promotion",
    "source_revision",
    "source_manifest_sha256",
    "duration_ms",
    "checks",
    "runtime_assets",
    "candidate_attestation_report",
    "blockers"
  ],
  "properties": {
    "version": { "const": "cogs.stage2-phase-b-qualification/v1" },
    "stage": { "const": "phase-b-discovery" },
    "authority": { "const": "candidate" },
    "qualified": { "const": false },
    "promotion": { "const": false },
    "source_revision": { "$ref": "#/$defs/revision" },
    "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "duration_ms": { "type": "integer", "minimum": 0, "maximum": 5400000 },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_assets", "attestation", "cleanup", "residue"],
      "properties": {
        "runtime_assets": { "const": "pass" },
        "attestation": { "const": "pass" },
        "cleanup": { "const": "pass" },
        "residue": { "const": "pass" }
      }
    },
    "runtime_assets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/asset" }
    },
    "candidate_attestation_report": { "$ref": "#/$defs/attestation" },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "contains": { "const": "candidate-non-authoritative" },
      "items": { "$ref": "#/$defs/code" }
    }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "code": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "release", "name", "size", "sha256", "downloaded", "extracted"],
      "properties": {
        "component": { "enum": ["kata", "containerd"] },
        "release": { "enum": ["3.32.0", "2.2.1"] },
        "name": { "enum": ["kata-static-3.32.0-amd64.tar.zst", "containerd-static-2.2.1-linux-amd64.tar.gz"] },
        "size": { "enum": [1547940938, 33645699] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "downloaded": { "const": true },
        "extracted": { "const": false }
      }
    },
    "versionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "sha256", "exit_status"],
      "properties": {
        "length": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "exit_status": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "closure_sha256", "version"],
      "properties": {
        "name": { "enum": ["ctr", "ip", "tc", "nft", "ssh", "ssh-keygen", "tar", "zstd"] },
        "closure_sha256": { "$ref": "#/$defs/sha256" },
        "version": { "$ref": "#/$defs/versionIdentity" }
      }
    },
    "digestIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "sha256"],
      "properties": {
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "size", "sha256"],
      "properties": {
        "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "countIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_count", "sha256"],
      "properties": {
        "entry_count": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "archive", "preflight", "layout"],
      "properties": {
        "component": { "enum": ["kata", "containerd"] },
        "archive": { "$ref": "#/$defs/digestIdentity" },
        "preflight": { "$ref": "#/$defs/countIdentity" },
        "layout": { "$ref": "#/$defs/countIdentity" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "authority",
        "qualified",
        "gate_opened",
        "owner_opened",
        "source",
        "host",
        "runtime",
        "metadata_only"
      ],
      "properties": {
        "version": { "const": "cogs.stage2-phase-b-attestation-candidate/v1" },
        "authority": { "const": "candidate" },
        "qualified": { "const": false },
        "gate_opened": { "const": false },
        "owner_opened": { "const": false },
        "metadata_only": { "const": true },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "manifest_sha256"],
          "properties": {
            "revision": { "$ref": "#/$defs/revision" },
            "manifest_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tools", "extraction_helpers"],
          "properties": {
            "tools": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/tool" } },
            "extraction_helpers": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/tool" } }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "archives",
            "runtime_files",
            "private_versions",
            "private_config",
            "shared_fs",
            "kvm",
            "qmp",
            "fixture_digests"
          ],
          "properties": {
            "archives": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/archive" } },
            "runtime_files": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/fileIdentity" },
              "minProperties": 7,
              "maxProperties": 7,
              "propertyNames": {
                "enum": ["kata_config", "kata_runtime", "kata_shim", "qemu", "virtiofsd", "containerd", "ctr"]
              }
            },
            "private_versions": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/versionIdentity" },
              "minProperties": 2,
              "maxProperties": 2,
              "propertyNames": { "enum": ["containerd", "ctr"] }
            },
            "private_config": { "$ref": "#/$defs/digestIdentity" },
            "shared_fs": { "const": "virtio-fs" },
            "kvm": { "const": { "api_version": 12, "device_accessible": true } },
            "qmp": { "const": { "present": true, "enabled": true, "acceleration": "kvm", "tcg": false } },
            "fixture_digests": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/sha256" },
              "minProperties": 4,
              "maxProperties": 4,
              "propertyNames": { "enum": ["network", "runtime", "process", "share"] }
            }
          }
        }
      }
    }
  }
}
