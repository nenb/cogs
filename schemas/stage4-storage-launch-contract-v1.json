{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.dev/schemas/stage4-storage-launch-contract-v1.json",
  "title": "Cogs Stage 4 local static storage and launch object graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "authority",
    "storage",
    "workspace_lease",
    "launch_document",
    "runtime_class",
    "resources",
    "lifecycle",
    "bounded_io"
  ],
  "properties": {
    "version": { "const": "cogs.stage4-storage-launch-contract/v1" },
    "authority": { "const": "local-static-storage-launch-contract" },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage_classes_distinct", "workspace", "trusted_session_state"],
      "properties": {
        "storage_classes_distinct": { "const": true },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "size_bytes",
            "access_mode",
            "volume_mode",
            "volume_binding_mode",
            "reclaim_policy",
            "medium",
            "mount_owner",
            "retention",
            "reclaim_on_session_end"
          ],
          "properties": {
            "role": { "const": "untrusted-project-workspace" },
            "size_bytes": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
            "access_mode": { "enum": ["ReadWriteOncePod", "ReadWriteOnce", "ReadWriteMany"] },
            "volume_mode": { "enum": ["Filesystem", "Block"] },
            "volume_binding_mode": { "enum": ["WaitForFirstConsumer", "Immediate", "unknown"] },
            "reclaim_policy": { "enum": ["Retain", "Delete", "unknown"] },
            "medium": { "enum": ["csi-block", "shared-filesystem", "unknown"] },
            "mount_owner": { "enum": ["kata-sandbox-only", "trusted-worker-proxy", "shared"] },
            "retention": {
              "enum": ["retain-until-explicit-workspace-deletion", "delete-on-session-end", "unspecified"]
            },
            "reclaim_on_session_end": { "type": "boolean" }
          }
        },
        "trusted_session_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "size_bytes",
            "access_mode",
            "volume_mode",
            "volume_binding_mode",
            "reclaim_policy",
            "mount_owner",
            "retention",
            "retention_seconds",
            "sandbox_visible"
          ],
          "properties": {
            "role": { "const": "trusted-pi-session-state" },
            "size_bytes": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
            "access_mode": { "enum": ["ReadWriteOncePod", "ReadWriteOnce", "ReadWriteMany"] },
            "volume_mode": { "enum": ["Filesystem", "Block"] },
            "volume_binding_mode": { "enum": ["WaitForFirstConsumer", "Immediate", "unknown"] },
            "reclaim_policy": { "enum": ["Retain", "Delete", "unknown"] },
            "mount_owner": { "enum": ["trusted-worker-only", "kata-sandbox", "shared"] },
            "retention": {
              "enum": ["retain-30-days-after-session-close", "delete-on-session-end", "unspecified"]
            },
            "retention_seconds": { "type": "integer", "minimum": 0, "maximum": 31536000 },
            "sandbox_visible": { "type": "boolean" }
          }
        }
      }
    },
    "workspace_lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "writer_limit",
        "writer_count",
        "state",
        "holder_launch_document_sha256",
        "fencing",
        "expiry_allows_takeover",
        "uncertain_takeover"
      ],
      "properties": {
        "workspace_id": { "$ref": "#/$defs/opaqueId" },
        "writer_limit": { "const": 1 },
        "writer_count": { "type": "integer", "minimum": 0, "maximum": 8 },
        "state": { "enum": ["held", "release-requested", "released", "uncertain"] },
        "holder_launch_document_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "fencing": { "const": "required-monotonic-token" },
        "expiry_allows_takeover": { "const": false },
        "uncertain_takeover": { "const": "deny-and-preserve" }
      }
    },
    "launch_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_sha256",
        "source_revision_sha256",
        "immutable",
        "state",
        "admission_count",
        "ssh_host_key",
        "ephemeral_ssh_identity",
        "ephemeral_proxy_identity",
        "durable_identity_material",
        "sandbox_secret_store_handles"
      ],
      "properties": {
        "document_sha256": { "$ref": "#/$defs/sha256" },
        "source_revision_sha256": { "$ref": "#/$defs/sha256" },
        "immutable": { "const": true },
        "state": { "enum": ["admitted-once", "stale", "replayed"] },
        "admission_count": { "type": "integer", "minimum": 0, "maximum": 8 },
        "ssh_host_key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pin", "verification", "on_mismatch"],
          "properties": {
            "pin": { "const": "a-priori-out-of-band" },
            "verification": { "enum": ["match", "mismatch", "missing"] },
            "on_mismatch": { "const": "deny-no-tofu-no-update" }
          }
        },
        "ephemeral_ssh_identity": { "const": "out-of-band-memory-or-tmpfs-only" },
        "ephemeral_proxy_identity": { "const": "out-of-band-memory-or-tmpfs-only" },
        "durable_identity_material": { "type": "boolean" },
        "sandbox_secret_store_handles": { "type": "boolean" }
      }
    },
    "runtime_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_name", "resolution", "resolved_name", "fallback"],
      "properties": {
        "required_name": { "const": "kata-qemu-cogs" },
        "resolution": { "enum": ["present-static-assertion", "missing", "wrong"] },
        "resolved_name": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 253 }, { "type": "null" }]
        },
        "fallback": { "const": "deny-no-runc-or-tcg" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trusted_worker_proxy", "kata_sandbox"],
      "properties": {
        "trusted_worker_proxy": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/trustedResource" }
        },
        "kata_sandbox": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/sandboxResource" }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "trusted_worker_proxy",
        "kata_sandbox",
        "workspace_attachment",
        "session_state_attachment",
        "lease",
        "uncertainty_artifact_sha256"
      ],
      "properties": {
        "state": { "enum": ["active", "cleanup-requested", "complete", "uncertain"] },
        "trusted_worker_proxy": { "enum": ["present", "removal-requested", "removed", "uncertain"] },
        "kata_sandbox": { "enum": ["present", "removal-requested", "removed", "uncertain"] },
        "workspace_attachment": { "enum": ["attached", "detach-requested", "detached", "uncertain"] },
        "session_state_attachment": { "enum": ["attached", "detach-requested", "detached", "uncertain"] },
        "lease": { "enum": ["held", "release-requested", "released", "uncertain"] },
        "uncertainty_artifact_sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "bounded_io": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_contract_bytes",
        "max_snapshot_nodes",
        "max_depth",
        "max_string_bytes",
        "max_resources_per_role",
        "violation_action"
      ],
      "properties": {
        "max_contract_bytes": { "const": 131072 },
        "max_snapshot_nodes": { "const": 512 },
        "max_depth": { "const": 16 },
        "max_string_bytes": { "const": 2048 },
        "max_resources_per_role": { "const": 1 },
        "violation_action": { "const": "deny-and-preserve" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "trustedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "session_id",
        "launch_document_sha256",
        "containers",
        "workspace_mounted",
        "session_state_mounted",
        "ephemeral_identity_persistence"
      ],
      "properties": {
        "resource_id": { "$ref": "#/$defs/opaqueId" },
        "session_id": { "$ref": "#/$defs/opaqueId" },
        "launch_document_sha256": { "$ref": "#/$defs/sha256" },
        "containers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [{ "const": "worker" }, { "const": "proxy" }],
          "items": false
        },
        "workspace_mounted": { "type": "boolean" },
        "session_state_mounted": { "type": "boolean" },
        "ephemeral_identity_persistence": {
          "enum": ["none", "helm-values", "configmap", "report", "sandbox-secret-store-handle"]
        }
      }
    },
    "sandboxResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "session_id",
        "launch_document_sha256",
        "runtime_class_name",
        "containers",
        "workspace_mounted",
        "session_state_mounted",
        "trusted_sidecars",
        "secret_store_handles"
      ],
      "properties": {
        "resource_id": { "$ref": "#/$defs/opaqueId" },
        "session_id": { "$ref": "#/$defs/opaqueId" },
        "launch_document_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_class_name": { "type": "string", "minLength": 1, "maxLength": 253 },
        "containers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [{ "const": "sandbox" }],
          "items": false
        },
        "workspace_mounted": { "type": "boolean" },
        "session_state_mounted": { "type": "boolean" },
        "trusted_sidecars": { "type": "boolean" },
        "secret_store_handles": { "type": "boolean" }
      }
    }
  }
}
