        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failure"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": ["failed", "cancelled", "deadline", "not-started", "postwork", "over-bound"]
              },
              "structural_counters": {
                "$ref": "#/$defs/structuralCounters"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "prerequisite-failed"
              },
              "elapsed_ms": {
                "const": 0
              },
              "structural_counters": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not-reached"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "observer-ended"
              },
              "elapsed_ms": {
                "const": 0
              },
              "structural_counters": {
                "type": "null"
              }
            }
          }
        }
      ]
