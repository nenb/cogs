    },
    "schemaFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "inventory_sha256"],
      "properties": {
        "scope": {
          "const": "all-stage4-stage5-and-production-runtime-image-contract-schemas"
        },
        "inventory_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "dependencyFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_lock_sha256", "pi_version", "pi_agent_core_sri", "pi_ai_sri", "pi_coding_agent_sri"],
      "properties": {
        "package_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pi_version": {
          "const": "0.84.2"
        },
        "pi_agent_core_sri": {
          "type": "string",
          "pattern": "^sha512-"
        },
        "pi_ai_sri": {
          "type": "string",
          "pattern": "^sha512-"
        },
        "pi_coding_agent_sri": {
          "type": "string",
          "pattern": "^sha512-"
        }
      }
    },
    "releaseImagesFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "assertion_sha256",
        "review_sha256",
        "workflow_run_id",
        "image_source_sha",
        "image_source_tree_sha",
        "image_source_inventory_sha256",
        "worker",
        "sandbox"
      ],
      "properties": {
        "state": {
          "const": "reviewed-current-source-image-set"
        },
        "assertion_sha256": {
          "const": "2368b09be02dc6e21debd8f047e58400173d62ff13edc27398ddbfe1708474d4"
        },
        "review_sha256": {
          "const": "9e3f9ababef58e8b4cc90e9f007251c05a2065eb2ff2e25f928e7c8b4d61e216"
        },
        "workflow_run_id": {
          "const": 31856469035
        },
        "image_source_sha": {
          "const": "cb9ec3958f6f2571c7c3f90e25b645e49e288a3f"
        },
        "image_source_tree_sha": {
          "const": "bf47273803ee54b5a2fd29d61224836e9f1bfd77"
        },
        "image_source_inventory_sha256": {
          "const": "de0173b66335bbdfbc10968061fac058cfd5648d3a46beb5e537eefa8fa460b8"
        },
        "worker": {
          "const": "ghcr.io/nenb/cogs/worker@sha256:1e71b2d0cd65f16c9633e092311b885ff03f43f4036195326e1a9fc91ea57535"
        },
        "sandbox": {
          "const": "ghcr.io/nenb/cogs/sandbox@sha256:db475ee1d01d446fe79cc9efdad40c9589cefe60eb69bce2f35108ea44eb94fe"
