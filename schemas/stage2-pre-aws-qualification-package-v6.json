{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v6.json",
  "title": "H-G-Q seven-cycle non-AWS qualification with authenticated static runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "authority",
    "implementation_revision",
    "control_revision",
    "qualification_revision",
    "source_manifest_sha256",
    "static_control_sha256",
    "workflow_sha256",
    "result_schema_sha256",
    "rootfs_descriptor_sha256",
    "runtime_manifest_sha256",
    "fixture_commitment",
    "source_bindings",
    "cycle_artifact_custody",
    "mixed_preflight_run_id",
    "static_control_observation",
    "cycle_artifact_custody_sha256",
    "batch_commitment",
    "cycle_count",
    "workload_measurements",
    "cycles",
    "predecessor_versions",
    "claims"
  ],
  "properties": {
    "version": {
      "const": "cogs.stage2-pre-aws-qualification-package/v6"
    },
    "authority": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/properties/authority"
    },
    "implementation_revision": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/gitSha"
    },
    "control_revision": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/gitSha"
    },
    "qualification_revision": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/gitSha"
    },
    "source_manifest_sha256": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/sha256"
    },
    "static_control_sha256": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/sha256"
    },
    "workflow_sha256": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/sha256"
    },
    "result_schema_sha256": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/sha256"
    },
    "rootfs_descriptor_sha256": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/sha256"
    },
    "runtime_manifest_sha256": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/sha256"
    },
    "fixture_commitment": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/sha256"
    },
    "source_bindings": {
      "$ref": "https://cogs.dev/schemas/stage2-formal-local-cycle-receipt-v2.json#/$defs/sourceBindings"
    },
    "cycle_artifact_custody": {
      "$ref": "https://cogs.dev/schemas/stage2-formal-local-artifact-custody-v2.json"
    },
    "mixed_preflight_run_id": {
      "type": "integer",
      "minimum": 1
    },
    "static_control_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "artifact_id", "artifact_archive_digest", "runner_image"],
      "properties": {
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_id": {
          "type": "integer",
          "minimum": 1
        },
        "artifact_archive_digest": {
          "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/archiveDigest"
        },
        "runner_image": {
          "$ref": "#/$defs/runnerImage"
        }
      }
    },
    "cycle_artifact_custody_sha256": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/sha256"
    },
    "batch_commitment": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/sha256"
    },
    "cycle_count": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/properties/cycle_count"
    },
    "workload_measurements": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/properties/workload_measurements"
    },
    "cycles": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "mode",
          "grant_commitment",
          "receipt_sha256",
          "status_sha256",
          "artifact_name",
          "artifact_id",
          "artifact_archive_digest",
          "runner_image",
          "identities"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "mode": {
            "enum": ["full", "readiness"]
          },
          "grant_commitment": {
            "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/sha256"
          },
          "receipt_sha256": {
            "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/sha256"
          },
          "status_sha256": {
            "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/sha256"
          },
          "artifact_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "artifact_id": {
            "type": "integer",
            "minimum": 1
          },
          "artifact_archive_digest": {
            "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/archiveDigest"
          },
          "runner_image": {
            "$ref": "#/$defs/runnerImage"
          },
          "identities": {
            "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/identities"
          }
        }
      }
    },
    "predecessor_versions": {
      "const": [
        "cogs.stage2-pre-aws-qualification-package/v1",
        "cogs.stage2-pre-aws-qualification-package/v2",
        "cogs.stage2-pre-aws-qualification-package/v3",
        "cogs.stage2-pre-aws-qualification-package/v4",
        "cogs.stage2-pre-aws-qualification-package/v5"
      ]
    },
    "claims": {
      "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/properties/claims"
    }
  },
  "$defs": {
    "runnerImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "image_label",
        "image_os",
        "image_version",
        "release_tag",
        "release_id",
        "release_commit"
      ],
      "properties": {
        "version": {
          "const": "cogs.github-hosted-runner-image/v1"
        },
        "image_label": {
          "const": "ubuntu-24.04"
        },
        "image_os": {
          "const": "ubuntu24"
        },
        "image_version": {
          "type": "string",
          "pattern": "^[0-9]{8}\\.[0-9]+\\.[0-9]+$"
        },
        "release_tag": {
          "type": "string",
          "pattern": "^ubuntu24/[0-9]{8}\\.[0-9]+$"
        },
        "release_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "release_commit": {
          "$ref": "https://cogs.dev/schemas/stage2-pre-aws-qualification-package-v3.json#/$defs/gitSha"
        }
      }
    }
  }
}
