{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.local/schemas/entry-fragments-v1.json",
  "title": "Cogs permitted history fragment page v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projection", "fragments", "snapshotFinal"],
  "properties": {
    "version": { "const": "cogs.entry-fragments/v1" },
    "projection": { "const": "cogs.permitted-json/v1" },
    "fragments": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entryId", "offset", "totalBytes", "encoding", "data", "final"],
        "properties": {
          "entryId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "offset": { "type": "integer", "minimum": 0, "maximum": 67108863 },
          "totalBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
          "encoding": { "const": "base64" },
          "data": {
            "type": "string",
            "minLength": 4,
            "maxLength": 65536,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "final": { "type": "boolean" }
        }
      }
    },
    "snapshotFinal": { "type": "boolean" },
    "next": { "type": "string", "minLength": 3, "maxLength": 2048, "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" },
    "tail": { "type": "string", "minLength": 3, "maxLength": 2048, "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$" }
  },
  "allOf": [
    {
      "if": { "properties": { "snapshotFinal": { "const": true } }, "required": ["snapshotFinal"] },
      "then": { "required": ["tail"], "not": { "required": ["next"] } },
      "else": { "required": ["next"], "not": { "required": ["tail"] } }
    }
  ]
}
