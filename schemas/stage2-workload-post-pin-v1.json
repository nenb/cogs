{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.invalid/schemas/stage2-workload-post-pin-v1.json",
  "title": "Non-authoritative Stage 2 host post-pin reproduction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "result",
    "authority",
    "candidate_contract_sha256",
    "final_pin_sha256",
    "package_identity",
    "reproductions",
    "matches_final_pin",
    "lifecycle_deleted",
    "execution_binding"
  ],
  "properties": {
    "version": { "const": "cogs.stage2-workload-post-pin/v1" },
    "result": { "const": "pass" },
    "authority": { "const": "non-authoritative-host-reproduction-only" },
    "candidate_contract_sha256": { "const": "b8660b92d778e9f5dc89586df4f68a2e2b12cdce818ff4fe12adf0a8e951fdf3" },
    "final_pin_sha256": { "$ref": "#/$defs/sha256" },
    "package_identity": { "$ref": "#/$defs/identity" },
    "reproductions": { "$ref": "#/$defs/reproductions" },
    "matches_final_pin": { "const": true },
    "lifecycle_deleted": { "const": true },
    "execution_binding": { "$ref": "#/$defs/executionBinding" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deb_sha256",
        "deb_bytes",
        "installed_tree_sha256",
        "installed_entries",
        "installed_bytes",
        "package",
        "version",
        "architecture"
      ],
      "properties": {
        "deb_sha256": { "$ref": "#/$defs/sha256" },
        "deb_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "installed_tree_sha256": { "const": "78aa672b7bd34a21fdd70d9adc2beb1693be06c8ad910db359456f8e5e57d7b2" },
        "installed_entries": { "const": 259 },
        "installed_bytes": { "const": 1048576 },
        "package": { "const": "cogs-stage2-fixture" },
        "version": { "const": "1.0" },
        "architecture": { "const": "all" }
      }
    },
    "reproductions": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "deleted"],
          "properties": { "id": { "const": "A" }, "deleted": { "const": true } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "deleted"],
          "properties": { "id": { "const": "B" }, "deleted": { "const": true } }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "toolObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "bytes", "version"],
      "properties": {
        "name": { "enum": ["git", "dpkg-deb", "dpkg"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "version": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "executionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_implementation_sha256",
        "workload_implementation_sha256",
        "orchestrator_implementation_sha256",
        "tool_observations",
        "contract_validator",
        "source_checkout",
        "linux_dynamic_tool_closure",
        "rootfs_execution"
      ],
      "properties": {
        "fixture_implementation_sha256": {
          "const": "c877bdbbce0f1c7920294f5a240aa8b83c81dd96ce3c4daab650a9fbadc7f9f4"
        },
        "workload_implementation_sha256": {
          "const": "451ddb9e65998c3599c534188eb5bbb6270cd0c899cc9dbd2a43106010661797"
        },
        "orchestrator_implementation_sha256": {
          "const": "75abc89837833084c2dec1b5d7be1f546261997475a7e73a14a6bede8511dc77"
        },
        "tool_observations": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/toolObservation" },
                { "type": "object", "properties": { "name": { "const": "git" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/toolObservation" },
                { "type": "object", "properties": { "name": { "const": "dpkg-deb" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/toolObservation" },
                { "type": "object", "properties": { "name": { "const": "dpkg" } } }
              ]
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "contract_validator": { "const": "unbound-self-referential-host-validator" },
        "source_checkout": { "const": "unbound-current-checkout" },
        "linux_dynamic_tool_closure": { "const": "unbound-kernel-libc-loader-libraries-config-helpers" },
        "rootfs_execution": { "const": "not-used-by-host-candidate-or-reproduction" }
      }
    }
  }
}
