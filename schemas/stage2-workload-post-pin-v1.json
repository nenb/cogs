{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.invalid/schemas/stage2-workload-post-pin-v1.json",
  "title": "Structural envelope for a non-authoritative Stage 2 host post-pin reproduction",
  "$comment": "Schema validation is structural only. Semantic validation requires validate_post_pin_result(value, exact_final_pin).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "result",
    "authority",
    "candidate_contract_sha256",
    "final_pin_sha256",
    "package_identity",
    "reproductions",
    "matches_final_pin",
    "lifecycle_deleted",
    "execution_binding"
  ],
  "properties": {
    "version": {
      "const": "cogs.stage2-workload-post-pin/v1"
    },
    "result": {
      "const": "pass"
    },
    "authority": {
      "const": "non-authoritative-host-reproduction-only"
    },
    "candidate_contract_sha256": {
      "const": "b8660b92d778e9f5dc89586df4f68a2e2b12cdce818ff4fe12adf0a8e951fdf3"
    },
    "final_pin_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "package_identity": {
      "$ref": "#/$defs/identity"
    },
    "reproductions": {
      "$ref": "#/$defs/reproductions"
    },
    "matches_final_pin": {
      "const": true
    },
    "lifecycle_deleted": {
      "const": true
    },
    "execution_binding": {
      "$ref": "#/$defs/executionBinding"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deb_sha256",
        "deb_bytes",
        "installed_tree_sha256",
        "installed_entries",
        "installed_bytes",
        "package",
        "version",
        "architecture"
      ],
      "properties": {
        "deb_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "deb_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "installed_tree_sha256": {
          "const": "78aa672b7bd34a21fdd70d9adc2beb1693be06c8ad910db359456f8e5e57d7b2"
        },
        "installed_entries": {
          "const": 259
        },
        "installed_bytes": {
          "const": 1048576
        },
        "package": {
          "const": "cogs-stage2-fixture"
        },
        "version": {
          "const": "1.0"
        },
        "architecture": {
          "const": "all"
        }
      }
    },
    "reproductions": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "deleted"],
          "properties": {
            "id": {
              "const": "A"
            },
            "deleted": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "deleted"],
          "properties": {
            "id": {
              "const": "B"
            },
            "deleted": {
              "const": true
            }
          }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "toolObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "bytes", "version"],
      "properties": {
        "name": {
          "enum": ["git", "dpkg-deb", "dpkg"]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "executionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_implementation_sha256",
        "workload_implementation_sha256",
        "owner_implementation_sha256",
        "orchestrator_implementation_sha256",
        "candidate_recovery_implementation_sha256",
        "post_pin_recovery_implementation_sha256",
        "tool_observations",
        "contract_validator",
        "source_checkout",
        "linux_dynamic_tool_closure",
        "process_containment",
        "process_containment_limitation",
        "operation_parent_isolation",
        "rootfs_execution"
      ],
      "properties": {
        "fixture_implementation_sha256": {
          "const": "c877bdbbce0f1c7920294f5a240aa8b83c81dd96ce3c4daab650a9fbadc7f9f4"
        },
        "workload_implementation_sha256": {
          "const": "c856bb997e1d799c712cf08b48c2fb3de314b8e0efe8985908a5b58d08b3c850"
        },
        "orchestrator_implementation_sha256": {
          "const": "edb057827c213e35d00f9088abba238bf1ab687b963212eaa311acdc9f0f18f8"
        },
        "tool_observations": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/toolObservation"
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "git"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/toolObservation"
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "dpkg-deb"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/toolObservation"
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "dpkg"
                    }
                  }
                }
              ]
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "contract_validator": {
          "const": "unbound-self-referential-host-validator"
        },
        "source_checkout": {
          "const": "unbound-current-checkout"
        },
        "linux_dynamic_tool_closure": {
          "const": "unbound-kernel-libc-loader-libraries-config-helpers"
        },
        "rootfs_execution": {
          "const": "not-used-by-host-candidate-or-reproduction"
        },
        "owner_implementation_sha256": {
          "const": "9702447028b55a3534cdc25f964b566ef9469bba0ed13d79142b2514375f11b7"
        },
        "candidate_recovery_implementation_sha256": {
          "const": "1408a9b51b9e5a241a731ac2f453ee28ff1f44f8e92d4111cd9a4100010522e5"
        },
        "post_pin_recovery_implementation_sha256": {
          "const": "1bae8dbde70ea7c0465dbb808a9d85205d88cdf03302f389128a25884ec2c060"
        },
        "process_containment": {
          "const": "linux-subreaper-pidfd-or-start-time-no-cgroup-v2"
        },
        "process_containment_limitation": {
          "const": "no-cgroup-proof-honest-supervisor-crash-only-not-hostile-process-closure"
        },
        "operation_parent_isolation": {
          "const": "root-owned-mode-0700-parent-workload-uid-gid-65534-zero-capabilities-nnp"
        }
      }
    }
  }
}
