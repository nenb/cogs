{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.dev/schemas/stage5-destructive-fixture-suite-v1.json",
  "title": "Cogs bounded synthetic Stage 5 destructive fixture suite",
  "description": "Local/static deterministic state-machine input only; no runtime, environment, campaign, or release evidence.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 5,
  "required": ["version", "authority", "execution", "routes", "cases"],
  "properties": {
    "version": { "const": "cogs.stage5-destructive-fixture-suite/v1" },
    "authority": { "const": "local-static-synthetic-fixtures-only" },
    "execution": { "const": "pure-state-machine-no-external-effects" },
    "routes": { "$ref": "#/$defs/routes" },
    "cases": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 8,
      "required": ["cloud", "provider", "cluster", "deployment", "external_model", "scheduler", "controller", "retry"],
      "properties": {
        "cloud": { "const": false },
        "provider": { "const": false },
        "cluster": { "const": false },
        "deployment": { "const": false },
        "external_model": { "const": false },
        "scheduler": { "const": false },
        "controller": { "const": false },
        "retry": { "const": false }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 7,
      "required": ["id", "fault", "profile", "applicability", "prompt_state", "owned_resources", "actions"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9.-]+$" },
        "fault": {
          "enum": [
            "process",
            "proxy",
            "openbao",
            "otlp",
            "wal",
            "disk",
            "sse",
            "jsonl",
            "git",
            "skill",
            "hostile-output"
          ]
        },
        "profile": { "enum": ["insecure-container", "linux-kvm"] },
        "applicability": { "enum": ["functional-insecure", "authoritative-local-linux-kvm"] },
        "prompt_state": { "enum": ["none", "settled", "in-flight"] },
        "owned_resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9-]+$" }
        },
        "actions": {
          "type": "array",
          "minItems": 7,
          "maxItems": 13,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 4,
      "required": ["seq", "actor", "action", "resource"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0, "maximum": 12 },
        "actor": { "enum": ["parent", "fault"] },
        "action": {
          "enum": [
            "acquire-owned-resource",
            "admit-operation",
            "inject-process",
            "inject-proxy",
            "inject-openbao",
            "inject-otlp",
            "inject-wal",
            "inject-disk",
            "inject-sse",
            "inject-jsonl",
            "inject-git",
            "inject-skill",
            "inject-hostile-output",
            "revoke-admission",
            "mark-prompt-unknown",
            "forbid-unknown-prompt-replay",
            "deny-credentialed-egress",
            "drain-connection",
            "bound-telemetry-queue",
            "drop-telemetry-with-counter",
            "continue-ordinary-work",
            "reject-uncommitted-write",
            "preserve-prior-bytes",
            "report-explicit-failure",
            "reject-replay-gap",
            "require-paged-history",
            "reject-malformed-history",
            "warn-mapping-unavailable",
            "preserve-settled-turn",
            "reject-artifact-before-prompt",
            "truncate-inert-output",
            "preserve-metadata-only",
            "cleanup-owned-resource",
            "close-fixture"
          ]
        },
        "resource": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9-]+$" }
          ]
        }
      }
    }
  }
}
