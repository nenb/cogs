{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.dev/schemas/stage2-formal-local-cycle-status-v1.json",
  "title": "Canonical non-cloud formal qualification cycle status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "authority",
    "batch_commitment",
    "ordinal",
    "mode",
    "grant_commitment",
    "workflow_run",
    "artifact_name",
    "receipt",
    "identities",
    "lifecycle_objects",
    "workload_measurements",
    "outcomes",
    "claims"
  ],
  "properties": {
    "version": { "const": "cogs.stage2-formal-local-cycle-status/v1" },
    "authority": { "const": "non-aws-formal-qualification-cycle-status-only" },
    "batch_commitment": { "$ref": "#/$defs/sha256" },
    "ordinal": { "type": "integer", "minimum": 1, "maximum": 7 },
    "mode": { "enum": ["full", "readiness"] },
    "grant_commitment": { "$ref": "#/$defs/sha256" },
    "workflow_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt"],
      "properties": { "id": { "type": "integer", "minimum": 1 }, "attempt": { "const": 1 } }
    },
    "artifact_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 98304 }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_boot_id", "operation", "rootfs", "runtime", "client_key", "host_key"],
      "properties": {
        "host_boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "operation": { "$ref": "#/$defs/sha256" },
        "rootfs": { "$ref": "#/$defs/sha256" },
        "runtime": { "$ref": "#/$defs/sha256" },
        "client_key": { "$ref": "#/$defs/sha256" },
        "host_key": { "$ref": "#/$defs/sha256" }
      }
    },
    "lifecycle_objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootfs_leases", "runtime_stages", "task_launches"],
      "properties": {
        "rootfs_leases": { "const": 1 },
        "runtime_stages": { "const": 1 },
        "task_launches": { "const": 1 }
      }
    },
    "workload_measurements": { "enum": [0, 21] },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "recovery", "fixed_cleanup", "independent_residue", "publication"],
      "properties": {
        "entry": { "const": "success" },
        "recovery": { "const": "success" },
        "fixed_cleanup": { "const": "success" },
        "independent_residue": { "const": "success" },
        "publication": { "const": "success" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal_non_aws_cycle_passed", "aws_authorized", "provider_executed", "promotion_authorized"],
      "properties": {
        "formal_non_aws_cycle_passed": { "const": true },
        "aws_authorized": { "const": false },
        "provider_executed": { "const": false },
        "promotion_authorized": { "const": false }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
