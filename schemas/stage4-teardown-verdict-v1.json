{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.dev/schemas/stage4-teardown-verdict-v1.json",
  "title": "Cogs Stage 4 local teardown claimed-evidence order verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_phase_count",
    "authority",
    "cloud_execution_observed",
    "cloud_inventory_observed",
    "evidence_root_sha256",
    "next_phase",
    "plan_sha256",
    "profile_sha256",
    "reason_code",
    "release_eligible",
    "source_sha256",
    "stage4_exit_satisfied",
    "status",
    "version"
  ],
  "properties": {
    "accepted_phase_count": {
      "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 8 }, { "type": "null" }]
    },
    "authority": { "const": "local-teardown-order-classifier" },
    "cloud_execution_observed": { "const": false },
    "cloud_inventory_observed": { "const": false },
    "evidence_root_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "next_phase": {
      "oneOf": [{ "$ref": "#/$defs/phase" }, { "type": "null" }]
    },
    "plan_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "profile_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "reason_code": { "$ref": "#/$defs/reasonCode" },
    "release_eligible": { "const": false },
    "source_sha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "stage4_exit_satisfied": { "const": false },
    "status": { "enum": ["awaiting-evidence", "preserve-uncertain", "evidence-order-complete"] },
    "version": { "const": "cogs.stage4-teardown-verdict/v1" }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "evidence_root_sha256": { "$ref": "#/$defs/sha256" },
            "plan_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "properties": {
            "evidence_root_sha256": { "type": "null" },
            "plan_sha256": { "type": "null" }
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "accepted_phase_count": { "type": "integer", "minimum": 0, "maximum": 7 },
            "evidence_root_sha256": { "$ref": "#/$defs/sha256" },
            "next_phase": { "$ref": "#/$defs/phase" },
            "plan_sha256": { "$ref": "#/$defs/sha256" },
            "profile_sha256": { "$ref": "#/$defs/sha256" },
            "reason_code": { "const": "STAGE4_AWAITING_EVIDENCE" },
            "source_sha256": { "$ref": "#/$defs/sha256" },
            "status": { "const": "awaiting-evidence" }
          }
        },
        {
          "properties": {
            "next_phase": { "type": "null" },
            "reason_code": {
              "enum": [
                "STAGE4_UNCERTAIN_EVIDENCE",
                "STAGE4_INVALID_VERSION",
                "STAGE4_INVALID_SHAPE",
                "STAGE4_INVALID_PHASE_ORDER",
                "STAGE4_INVALID_PRODUCER_CLASS",
                "STAGE4_INVALID_EVIDENCE",
                "STAGE4_EVIDENCE_REPLAY",
                "STAGE4_EVIDENCE_OUT_OF_ORDER"
              ]
            },
            "status": { "const": "preserve-uncertain" }
          }
        },
        {
          "properties": {
            "accepted_phase_count": { "const": 8 },
            "evidence_root_sha256": { "$ref": "#/$defs/sha256" },
            "next_phase": { "type": "null" },
            "plan_sha256": { "$ref": "#/$defs/sha256" },
            "profile_sha256": { "$ref": "#/$defs/sha256" },
            "reason_code": { "const": "STAGE4_EVIDENCE_ORDER_COMPLETE" },
            "source_sha256": { "$ref": "#/$defs/sha256" },
            "status": { "const": "evidence-order-complete" }
          }
        }
      ]
    }
  ],
  "$defs": {
    "phase": {
      "enum": [
        "freeze-reconcilers",
        "close-admission",
        "revoke-credentials",
        "revoke-readiness",
        "remove-session-workloads",
        "verify-kubernetes-zero",
        "remove-cluster-infrastructure",
        "record-external-cloud-inventory-claim"
      ]
    },
    "reasonCode": {
      "enum": [
        "STAGE4_AWAITING_EVIDENCE",
        "STAGE4_UNCERTAIN_EVIDENCE",
        "STAGE4_EVIDENCE_ORDER_COMPLETE",
        "STAGE4_INVALID_VERSION",
        "STAGE4_INVALID_SHAPE",
        "STAGE4_INVALID_PHASE_ORDER",
        "STAGE4_INVALID_PRODUCER_CLASS",
        "STAGE4_INVALID_EVIDENCE",
        "STAGE4_EVIDENCE_REPLAY",
        "STAGE4_EVIDENCE_OUT_OF_ORDER"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
