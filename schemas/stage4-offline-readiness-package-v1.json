{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.dev/schemas/stage4-offline-readiness-package-v1.json",
  "title": "Cogs bounded local/static Stage 4 offline readiness package v1",
  "description": "A canonical digest-bound local package only; never campaign approval, provider truth, Stage 4 exit, or release evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "authority",
    "claims",
    "artifact_bindings",
    "source",
    "pins",
    "local_validation",
    "campaign_proposal",
    "attempt_authority",
    "stop_destroy",
    "identities",
    "revalidation",
    "blockers"
  ],
  "properties": {
    "version": { "const": "cogs.stage4-offline-readiness-package/v1" },
    "authority": { "const": "local-static-stage4-readiness-package" },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_preparation_complete",
        "campaign_request_ready",
        "campaign_approved",
        "cloud_authorized",
        "cloud_execution_observed",
        "provider_truth_observed",
        "current_resources_observed",
        "zero_resources_claimed",
        "stage4_exit_satisfied",
        "release_eligible"
      ],
      "properties": {
        "local_preparation_complete": { "const": true },
        "campaign_request_ready": { "const": false },
        "campaign_approved": { "const": false },
        "cloud_authorized": { "const": false },
        "cloud_execution_observed": { "const": false },
        "provider_truth_observed": { "const": false },
        "current_resources_observed": { "const": false },
        "zero_resources_claimed": { "const": false },
        "stage4_exit_satisfied": { "const": false },
        "release_eligible": { "const": false }
      }
    },
    "artifact_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_inventory_sha256",
        "chart_inventory_sha256",
        "values_sha256",
        "render_sha256",
        "repeated_render_sha256",
        "image_lock_sha256",
        "nic_contract_sha256",
        "runtime_pins_sha256",
        "schema_inventory_sha256",
        "local_validation_sha256",
        "renders_byte_identical",
        "binding_root_sha256"
      ],
      "properties": {
        "source_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "chart_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "values_sha256": { "$ref": "#/$defs/sha256" },
        "render_sha256": { "$ref": "#/$defs/sha256" },
        "repeated_render_sha256": { "$ref": "#/$defs/sha256" },
        "image_lock_sha256": { "$ref": "#/$defs/sha256" },
        "nic_contract_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_pins_sha256": { "$ref": "#/$defs/sha256" },
        "schema_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "local_validation_sha256": { "$ref": "#/$defs/sha256" },
        "renders_byte_identical": { "const": true },
        "binding_root_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrated_predecessor_git_commit",
        "inventory_scope",
        "inventory_algorithm",
        "release_candidate_binding_present"
      ],
      "properties": {
        "integrated_predecessor_git_commit": { "const": "b673609f7ed7b53d3085afbd83094a9b3c4f9511" },
        "inventory_scope": { "const": "bounded-exact-readiness-source-closure" },
        "inventory_algorithm": { "const": "sha256-over-exact-file-bytes" },
        "release_candidate_binding_present": { "const": false }
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chart", "values", "images", "nic", "runtime"],
      "properties": {
        "chart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "delivery"],
          "properties": {
            "name": { "const": "cogs" },
            "version": { "const": "0.0.1" },
            "delivery": { "const": "notes-only-zero-submitted-manifests" }
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "data_class"],
          "properties": {
            "profile": { "const": "stage4-notes-source-shapes-valid" },
            "data_class": { "const": "synthetic-only" }
          }
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worker", "proxy", "sandbox", "release_image_set_present"],
          "properties": {
            "worker": { "$ref": "#/$defs/syntheticImage" },
            "proxy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reference", "state"],
              "properties": {
                "reference": {
                  "const": "envoyproxy/envoy:v1.38.3@sha256:5f7c43e1147412fdb3af578c651c67478a3df818eae89d2261e707e06c209cdb"
                },
                "state": { "const": "exact-static-input-not-runtime-observed" }
              }
            },
            "sandbox": { "$ref": "#/$defs/syntheticImage" },
            "release_image_set_present": { "const": false }
          }
        },
        "nic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release",
            "commit_sha",
            "module_version",
            "module_commit_sha",
            "capability_state",
            "reason_code"
          ],
          "properties": {
            "release": { "const": "v0.11.0" },
            "commit_sha": { "const": "28221c652c56bb8d48a92538c01503a82f2f9321" },
            "module_version": { "const": "0.7.0" },
            "module_commit_sha": { "const": "5d4cb31f07fda5c010b5be580258d32f6db75828" },
            "capability_state": { "const": "blocked-missing-custom-launch-template-and-nested-cpu-options" },
            "reason_code": { "const": "STAGE4_NIC_LAUNCH_TEMPLATE_CAPABILITY_MISSING" }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kata_version",
            "kata_archive_sha256",
            "containerd_version",
            "qemu_version",
            "accelerator",
            "runc_fallback",
            "tcg_fallback",
            "eks_node_ami_id",
            "eks_node_image_release",
            "eks_node_kernel_release",
            "node_image_state"
          ],
          "properties": {
            "kata_version": { "const": "3.32.0" },
            "kata_archive_sha256": {
              "const": "1449ecea50bd91fa73a94648db195d18950fe869ba4b1f12d05f55f1fa7c1b01"
            },
            "containerd_version": { "const": "2.2.1" },
            "qemu_version": { "const": "8.2.2" },
            "accelerator": { "const": "kvm-only" },
            "runc_fallback": { "const": false },
            "tcg_fallback": { "const": false },
            "eks_node_ami_id": { "type": "null" },
            "eks_node_image_release": { "type": "null" },
            "eks_node_kernel_release": { "type": "null" },
            "node_image_state": { "const": "unresolved-blocking" }
          }
        }
      }
    },
    "local_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "status", "provider_execution", "kubernetes_execution", "external_model_execution"],
      "properties": {
        "profile": { "const": "local-static-only" },
        "status": { "const": "passed-structural-and-local-contract-checks" },
        "provider_execution": { "const": false },
        "kubernetes_execution": { "const": false },
        "external_model_execution": { "const": false }
      }
    },
    "campaign_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "account_binding",
        "region",
        "sandbox_instance_type_ceiling",
        "nodes",
        "resource_caps",
        "spend",
        "time",
        "access",
        "data",
        "prohibited_resources"
      ],
      "properties": {
        "state": { "const": "proposal-only-not-approved-not-price-or-quota-validated" },
        "account_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "account_sha256"],
          "properties": {
            "state": { "const": "absent-blocking" },
            "account_sha256": { "type": "null" }
          }
        },
        "region": { "const": "us-east-1" },
        "sandbox_instance_type_ceiling": { "const": "c8i-flex.large" },
        "nodes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sandbox_min", "sandbox_max", "trusted_max", "total_max"],
          "properties": {
            "sandbox_min": { "const": 0 },
            "sandbox_max": { "const": 1 },
            "trusted_max": { "const": 1 },
            "total_max": { "const": 2 }
          }
        },
        "resource_caps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eks_clusters",
            "sandbox_node_groups",
            "trusted_node_groups",
            "workspace_volumes",
            "workspace_gib_each",
            "session_state_volumes",
            "session_state_gib_each",
            "nat_gateways",
            "load_balancers",
            "elastic_ips",
            "efs_filesystems",
            "public_ingress_endpoints"
          ],
          "properties": {
            "eks_clusters": { "const": 1 },
            "sandbox_node_groups": { "const": 1 },
            "trusted_node_groups": { "const": 1 },
            "workspace_volumes": { "const": 1 },
            "workspace_gib_each": { "const": 20 },
            "session_state_volumes": { "const": 1 },
            "session_state_gib_each": { "const": 5 },
            "nat_gateways": { "const": 0 },
            "load_balancers": { "const": 0 },
            "elastic_ips": { "const": 0 },
            "efs_filesystems": { "const": 0 },
            "public_ingress_endpoints": { "const": 0 }
          }
        },
        "spend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "currency", "cap", "alert_thresholds", "hard_kill_claimed"],
          "properties": {
            "state": { "const": "proposal-only-current-price-not-discovered" },
            "currency": { "const": "USD" },
            "cap": { "const": 20 },
            "alert_thresholds": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [{ "const": 5 }, { "const": 10 }, { "const": 20 }],
              "items": false
            },
            "hard_kill_claimed": { "const": false }
          }
        },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eks_duration_seconds", "absolute_ttl_seconds", "idle_debugging_cluster_allowed"],
          "properties": {
            "eks_duration_seconds": { "const": 5400 },
            "absolute_ttl_seconds": { "const": 14400 },
            "idle_debugging_cluster_allowed": { "const": false }
          }
        },
        "access": { "const": "proposed-ssm-only-no-public-ssh-unexecuted" },
        "data": { "const": "synthetic-repositories-identities-credentials-and-sessions-only" },
        "prohibited_resources": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "prefixItems": [
            { "const": "gpu" },
            { "const": "bare-metal" },
            { "const": "spot" },
            { "const": "nat-gateway" },
            { "const": "load-balancer" },
            { "const": "elastic-ip" },
            { "const": "efs-workspace" },
            { "const": "public-ingress" },
            { "const": "production-data" },
            { "const": "second-sandbox-node" },
            { "const": "larger-instance" },
            { "const": "other-region" }
          ],
          "items": false
        }
      }
    },
    "attempt_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_envelope_present",
        "approval_present",
        "attempt_id_present",
        "maximum_attempts_per_approval",
        "prior_approval_authorizes_retry",
        "retry_requires_fresh_revalidation_and_approval",
        "executable_provider_route_present"
      ],
      "properties": {
        "campaign_envelope_present": { "const": false },
        "approval_present": { "const": false },
        "attempt_id_present": { "const": false },
        "maximum_attempts_per_approval": { "const": 1 },
        "prior_approval_authorizes_retry": { "const": false },
        "retry_requires_fresh_revalidation_and_approval": { "const": true },
        "executable_provider_route_present": { "const": false }
      }
    },
    "stop_destroy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commands_or_targets_present",
        "cases",
        "destroy_required_after_every_outcome",
        "uncertainty_blocks_success_and_retry",
        "independent_inventory"
      ],
      "properties": {
        "kind": { "const": "non-executable-proposed-control-flow" },
        "commands_or_targets_present": { "const": false },
        "cases": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {
              "type": "object",
              "$ref": "#/$defs/stopCase",
              "properties": {
                "case": { "const": "apply-failure" },
                "result": { "const": "stop-preserve-evidence-require-destroy-and-independent-inventory" }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/stopCase",
              "properties": {
                "case": { "const": "bootstrap-failure" },
                "result": { "const": "stop-preserve-evidence-require-destroy-and-independent-inventory" }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/stopCase",
              "properties": {
                "case": { "const": "test-failure" },
                "result": { "const": "stop-preserve-evidence-require-destroy-and-independent-inventory" }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/stopCase",
              "properties": {
                "case": { "const": "timeout" },
                "result": { "const": "stop-preserve-evidence-require-destroy-and-independent-inventory" }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/stopCase",
              "properties": {
                "case": { "const": "interruption" },
                "result": { "const": "stop-preserve-evidence-require-destroy-and-independent-inventory" }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/stopCase",
              "properties": {
                "case": { "const": "inventory-uncertainty" },
                "result": { "const": "preserve-uncertain-block-success-and-retry" }
              }
            }
          ],
          "items": false
        },
        "destroy_required_after_every_outcome": { "const": true },
        "uncertainty_blocks_success_and_retry": { "const": true },
        "independent_inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "zero_claimed", "scopes"],
          "properties": {
            "state": { "const": "required-future-unexecuted" },
            "zero_claimed": { "const": false },
            "scopes": {
              "type": "array",
              "minItems": 11,
              "maxItems": 11,
              "prefixItems": [
                { "const": "eks-clusters-and-nodegroups" },
                { "const": "ec2-instances-and-launch-templates" },
                { "const": "ebs-volumes-and-snapshots" },
                { "const": "network-interfaces" },
                { "const": "load-balancers-and-target-groups" },
                { "const": "elastic-ips" },
                { "const": "iam-campaign-roles-and-policies" },
                { "const": "security-groups" },
                { "const": "logs" },
                { "const": "ttl-schedules-and-functions" },
                { "const": "campaign-tagged-resources" }
              ],
              "items": false
            }
          }
        }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "separation_satisfied", "roles", "required_separations"],
      "properties": {
        "state": { "const": "absent-blocking" },
        "separation_satisfied": { "const": false },
        "roles": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {
              "type": "object",
              "$ref": "#/$defs/absentRole",
              "properties": { "role": { "const": "campaign-operator" } }
            },
            {
              "type": "object",
              "$ref": "#/$defs/absentRole",
              "properties": { "role": { "const": "campaign-approver" } }
            },
            {
              "type": "object",
              "$ref": "#/$defs/absentRole",
              "properties": { "role": { "const": "budget-approver" } }
            },
            {
              "type": "object",
              "$ref": "#/$defs/absentRole",
              "properties": { "role": { "const": "security-evidence-reviewer" } }
            },
            {
              "type": "object",
              "$ref": "#/$defs/absentRole",
              "properties": { "role": { "const": "zero-inventory-observer" } }
            }
          ],
          "items": false
        },
        "required_separations": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {
              "type": "object",
              "$ref": "#/$defs/separation",
              "properties": { "left": { "const": "campaign-operator" }, "right": { "const": "campaign-approver" } }
            },
            {
              "type": "object",
              "$ref": "#/$defs/separation",
              "properties": { "left": { "const": "campaign-operator" }, "right": { "const": "budget-approver" } }
            },
            {
              "type": "object",
              "$ref": "#/$defs/separation",
              "properties": {
                "left": { "const": "campaign-operator" },
                "right": { "const": "security-evidence-reviewer" }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/separation",
              "properties": {
                "left": { "const": "campaign-operator" },
                "right": { "const": "zero-inventory-observer" }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/separation",
              "properties": {
                "left": { "const": "campaign-approver" },
                "right": { "const": "zero-inventory-observer" }
              }
            },
            {
              "type": "object",
              "$ref": "#/$defs/separation",
              "properties": {
                "left": { "const": "security-evidence-reviewer" },
                "right": { "const": "zero-inventory-observer" }
              }
            }
          ],
          "items": false
        }
      }
    },
    "revalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_before_campaign_request", "issue_42_state", "price_state", "quota_state", "triggers"],
      "properties": {
        "required_before_campaign_request": { "const": true },
        "issue_42_state": { "const": "open-blocking" },
        "price_state": { "const": "not-discovered-by-this-package" },
        "quota_state": { "const": "not-discovered-by-this-package" },
        "triggers": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            { "const": "issue-42-closure" },
            { "const": "source-change" },
            { "const": "pin-change" },
            { "const": "price-change" },
            { "const": "quota-change" },
            { "const": "campaign-shape-change" }
          ],
          "items": false
        }
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        { "const": "ISSUE_42_OPEN" },
        { "const": "NIC_V0_11_0_MODULE_0_7_0_LAUNCH_TEMPLATE_CAPABILITY_MISSING" },
        { "const": "EKS_AMI_IMAGE_RELEASE_KERNEL_UNRESOLVED" },
        { "const": "PROPOSED_ACCOUNT_BINDING_ABSENT" },
        { "const": "CURRENT_PRICE_NOT_REVALIDATED" },
        { "const": "CURRENT_QUOTA_NOT_REVALIDATED" },
        { "const": "SEPARATED_CAMPAIGN_IDENTITIES_ABSENT" },
        { "const": "CAMPAIGN_ENVELOPE_AND_APPROVAL_ABSENT" },
        { "const": "NO_EXECUTABLE_PROVIDER_ROUTE" }
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "syntheticImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "state"],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^registry\\.example\\.invalid/cogs/(?:worker|sandbox)@sha256:[0-9a-f]{64}$",
          "maxLength": 160
        },
        "state": { "const": "synthetic-placeholder-not-release-image" }
      }
    },
    "stopCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "result"],
      "properties": {
        "case": { "type": "string", "maxLength": 32 },
        "result": {
          "enum": [
            "stop-preserve-evidence-require-destroy-and-independent-inventory",
            "preserve-uncertain-block-success-and-retry"
          ]
        }
      }
    },
    "absentRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "principal_binding_sha256", "state"],
      "properties": {
        "role": { "type": "string", "maxLength": 32 },
        "principal_binding_sha256": { "type": "null" },
        "state": { "const": "not-present-blocking" }
      }
    },
    "separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right", "state"],
      "properties": {
        "left": { "type": "string", "maxLength": 32 },
        "right": { "type": "string", "maxLength": 32 },
        "state": { "const": "required-not-proven" }
      }
    }
  }
}
