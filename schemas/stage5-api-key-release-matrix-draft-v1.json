{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.dev/schemas/stage5-api-key-release-matrix-draft-v1.json",
  "title": "Cogs provisional API-key-only Stage 5 release acceptance matrix draft",
  "description": "A bounded local/static requirements inventory only; never Stage 4 or Stage 5 evidence or release authority.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 24,
  "required": [
    "version",
    "authority",
    "issue",
    "scope",
    "draft",
    "provisional",
    "qualified",
    "campaign_authorized",
    "cloud_execution_observed",
    "independent_review_observed",
    "release_evidence_observed",
    "matrix_finalized",
    "release_eligible",
    "go_no_go",
    "stage4_dependency",
    "subscription_oauth",
    "release_candidate_binding",
    "principals",
    "separation_constraints",
    "support_claims",
    "criterion_mappings",
    "evidence_reference_contract"
  ],
  "properties": {
    "version": { "const": "cogs.stage5-api-key-release-matrix-draft/v1" },
    "authority": { "const": "provisional-local-static-requirements-only" },
    "issue": { "const": 363 },
    "scope": { "const": "api-key-only" },
    "draft": { "const": true },
    "provisional": { "const": true },
    "qualified": { "const": false },
    "campaign_authorized": { "const": false },
    "cloud_execution_observed": { "const": false },
    "independent_review_observed": { "const": false },
    "release_evidence_observed": { "const": false },
    "matrix_finalized": { "const": false },
    "release_eligible": { "const": false },
    "go_no_go": { "const": "not-available" },
    "stage4_dependency": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 4,
      "required": ["gate", "state", "stage4_exit_satisfied", "evidence_accepted"],
      "properties": {
        "gate": { "const": "S4-11" },
        "state": { "const": "required-not-observed-by-this-draft" },
        "stage4_exit_satisfied": { "const": false },
        "evidence_accepted": { "const": false }
      }
    },
    "subscription_oauth": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 5,
      "required": ["status", "advertised", "release_gate", "deferred_issue", "worker_refresh_tokens"],
      "properties": {
        "status": { "const": "disabled-unadvertised" },
        "advertised": { "const": false },
        "release_gate": { "const": false },
        "deferred_issue": { "const": 13 },
        "worker_refresh_tokens": { "const": "forbidden" }
      }
    },
    "release_candidate_binding": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 4,
      "required": ["source_revision", "artifact_root_sha256", "binding_sha256", "state"],
      "properties": {
        "source_revision": { "type": "null" },
        "artifact_root_sha256": { "type": "null" },
        "binding_sha256": { "type": "null" },
        "state": { "const": "not-present-blocking" }
      }
    },
    "principals": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {
          "$ref": "#/$defs/unboundPrincipal",
          "type": "object",
          "properties": { "role": { "const": "matrix-author" } }
        },
        {
          "$ref": "#/$defs/unboundPrincipal",
          "type": "object",
          "properties": { "role": { "const": "release-engineer" } }
        },
        {
          "$ref": "#/$defs/unboundPrincipal",
          "type": "object",
          "properties": { "role": { "const": "evidence-producer" } }
        },
        {
          "$ref": "#/$defs/unboundPrincipal",
          "type": "object",
          "properties": { "role": { "const": "independent-security-reviewer" } }
        },
        {
          "$ref": "#/$defs/unboundPrincipal",
          "type": "object",
          "properties": { "role": { "const": "campaign-operator" } }
        },
        {
          "$ref": "#/$defs/unboundPrincipal",
          "type": "object",
          "properties": { "role": { "const": "campaign-approver" } }
        },
        {
          "$ref": "#/$defs/unboundPrincipal",
          "type": "object",
          "properties": { "role": { "const": "budget-approver" } }
        },
        {
          "$ref": "#/$defs/unboundPrincipal",
          "type": "object",
          "properties": { "role": { "const": "zero-inventory-observer" } }
        },
        {
          "$ref": "#/$defs/unboundPrincipal",
          "type": "object",
          "properties": { "role": { "const": "staff-release-decider" } }
        }
      ],
      "items": false
    },
    "separation_constraints": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {
          "$ref": "#/$defs/separation",
          "type": "object",
          "properties": {
            "left_role": { "const": "independent-security-reviewer" },
            "right_role": { "const": "matrix-author" }
          }
        },
        {
          "$ref": "#/$defs/separation",
          "type": "object",
          "properties": {
            "left_role": { "const": "independent-security-reviewer" },
            "right_role": { "const": "evidence-producer" }
          }
        },
        {
          "$ref": "#/$defs/separation",
          "type": "object",
          "properties": {
            "left_role": { "const": "independent-security-reviewer" },
            "right_role": { "const": "campaign-operator" }
          }
        },
        {
          "$ref": "#/$defs/separation",
          "type": "object",
          "properties": {
            "left_role": { "const": "independent-security-reviewer" },
            "right_role": { "const": "campaign-approver" }
          }
        },
        {
          "$ref": "#/$defs/separation",
          "type": "object",
          "properties": {
            "left_role": { "const": "independent-security-reviewer" },
            "right_role": { "const": "zero-inventory-observer" }
          }
        },
        {
          "$ref": "#/$defs/separation",
          "type": "object",
          "properties": {
            "left_role": { "const": "campaign-operator" },
            "right_role": { "const": "campaign-approver" }
          }
        },
        {
          "$ref": "#/$defs/separation",
          "type": "object",
          "properties": {
            "left_role": { "const": "zero-inventory-observer" },
            "right_role": { "const": "campaign-operator" }
          }
        },
        {
          "$ref": "#/$defs/separation",
          "type": "object",
          "properties": {
            "left_role": { "const": "zero-inventory-observer" },
            "right_role": { "const": "campaign-approver" }
          }
        }
      ],
      "items": false
    },
    "support_claims": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 4,
      "required": ["posture", "api_key_providers", "platform_profiles", "unsupported_capabilities"],
      "properties": {
        "posture": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 4,
          "required": ["production_ready", "general_availability", "compliance_certified", "advertised_release"],
          "properties": {
            "production_ready": { "const": false },
            "general_availability": { "const": false },
            "compliance_certified": { "const": false },
            "advertised_release": { "const": false }
          }
        },
        "api_key_providers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/providerClaim",
              "type": "object",
              "properties": { "provider": { "const": "anthropic" } }
            },
            { "$ref": "#/$defs/providerClaim", "type": "object", "properties": { "provider": { "const": "openai" } } },
            {
              "$ref": "#/$defs/providerClaim",
              "type": "object",
              "properties": { "provider": { "const": "openrouter" } }
            }
          ],
          "items": false
        },
        "platform_profiles": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "$ref": "#/$defs/platformClaim",
              "type": "object",
              "properties": {
                "profile": { "const": "aws-eks-kata" },
                "status": { "const": "pending-s4-s5-evidence-unadvertised" }
              }
            },
            {
              "$ref": "#/$defs/platformClaim",
              "type": "object",
              "properties": {
                "profile": { "const": "linux-kvm" },
                "status": { "const": "authoritative-local-only-unadvertised" }
              }
            },
            {
              "$ref": "#/$defs/platformClaim",
              "type": "object",
              "properties": {
                "profile": { "const": "insecure-container" },
                "status": { "const": "development-only-unadvertised" }
              }
            },
            {
              "$ref": "#/$defs/platformClaim",
              "type": "object",
              "properties": {
                "profile": { "const": "macos-vm-dev" },
                "status": { "const": "development-only-unadvertised" }
              }
            }
          ],
          "items": false
        },
        "unsupported_capabilities": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "prefixItems": [
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": {
                "capability": { "const": "subscription-oauth" },
                "reason_code": { "const": "deferred-issue-13" }
              }
            },
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": { "capability": { "const": "production-daemon" } }
            },
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": { "capability": { "const": "user-ingress" } }
            },
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": { "capability": { "const": "session-sanitizer" } }
            },
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": { "capability": { "const": "apps" } }
            },
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": { "capability": { "const": "indexing-vector-search" } }
            },
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": {
                "capability": { "const": "gcp-production" },
                "reason_code": { "const": "other-cloud-not-validated" }
              }
            },
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": {
                "capability": { "const": "azure-production" },
                "reason_code": { "const": "other-cloud-not-validated" }
              }
            },
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": {
                "capability": { "const": "hetzner-production" },
                "reason_code": { "const": "other-cloud-not-validated" }
              }
            },
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": {
                "capability": { "const": "other-cloud-production" },
                "reason_code": { "const": "other-cloud-not-validated" }
              }
            },
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": {
                "capability": { "const": "general-availability" },
                "reason_code": { "const": "release-not-established" }
              }
            },
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": {
                "capability": { "const": "compliance-certification" },
                "reason_code": { "const": "compliance-not-claimed" }
              }
            },
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": { "capability": { "const": "grpc-credential-injection" } }
            },
            {
              "$ref": "#/$defs/unsupportedClaim",
              "type": "object",
              "properties": { "capability": { "const": "non-http-egress" } }
            }
          ],
          "items": false
        }
      }
    },
    "criterion_mappings": {
      "type": "array",
      "minItems": 35,
      "maxItems": 35,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/criterionMapping" }
    },
    "evidence_reference_contract": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 10,
      "required": [
        "digest_only",
        "inline_content_allowed",
        "diagnostics",
        "matrix_max_bytes",
        "max_references",
        "max_total_declared_bytes",
        "max_bytes_per_reference",
        "max_properties_per_reference",
        "max_string_length",
        "references"
      ],
      "properties": {
        "digest_only": { "const": true },
        "inline_content_allowed": { "const": false },
        "diagnostics": { "const": "categorical-only" },
        "matrix_max_bytes": { "const": 262144 },
        "max_references": { "const": 64 },
        "max_total_declared_bytes": { "const": 16777216 },
        "max_bytes_per_reference": { "const": 262144 },
        "max_properties_per_reference": { "const": 13 },
        "max_string_length": { "const": 128 },
        "references": {
          "allOf": [{ "$ref": "#/$defs/evidenceReferenceSet" }, { "type": "array", "maxItems": 0 }]
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "principalRole": {
      "enum": [
        "matrix-author",
        "release-engineer",
        "evidence-producer",
        "independent-security-reviewer",
        "campaign-operator",
        "campaign-approver",
        "budget-approver",
        "zero-inventory-observer",
        "staff-release-decider"
      ]
    },
    "unboundPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 4,
      "required": ["role", "principal_id", "identity_binding_sha256", "state"],
      "properties": {
        "role": { "$ref": "#/$defs/principalRole" },
        "principal_id": { "type": "null" },
        "identity_binding_sha256": { "type": "null" },
        "state": { "const": "not-present-blocking" }
      }
    },
    "separation": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 4,
      "required": ["left_role", "right_role", "relation", "state"],
      "properties": {
        "left_role": { "$ref": "#/$defs/principalRole" },
        "right_role": { "$ref": "#/$defs/principalRole" },
        "relation": { "const": "must-be-distinct-authenticated-principals" },
        "state": { "const": "blocked-identities-not-present" }
      }
    },
    "providerClaim": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 8,
      "required": [
        "provider",
        "auth_class",
        "implementation_state",
        "support_decision",
        "advertised",
        "real_provider_evidence_required",
        "evidence_binding_sha256",
        "blocker"
      ],
      "properties": {
        "provider": { "enum": ["anthropic", "openai", "openrouter"] },
        "auth_class": { "const": "api-key" },
        "implementation_state": { "const": "generic-runtime-key-path-present-provider-not-release-validated" },
        "support_decision": { "const": "provisional-candidate" },
        "advertised": { "const": false },
        "real_provider_evidence_required": { "const": true },
        "evidence_binding_sha256": { "type": "null" },
        "blocker": { "const": "provider-real-evidence-not-present" }
      }
    },
    "platformClaim": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 3,
      "required": ["profile", "status", "advertised"],
      "properties": {
        "profile": { "enum": ["aws-eks-kata", "linux-kvm", "insecure-container", "macos-vm-dev"] },
        "status": {
          "enum": [
            "pending-s4-s5-evidence-unadvertised",
            "authoritative-local-only-unadvertised",
            "development-only-unadvertised"
          ]
        },
        "advertised": { "const": false }
      }
    },
    "unsupportedClaim": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 5,
      "required": ["capability", "status", "advertised", "evidence_binding_sha256", "reason_code"],
      "properties": {
        "capability": {
          "enum": [
            "subscription-oauth",
            "production-daemon",
            "user-ingress",
            "session-sanitizer",
            "apps",
            "indexing-vector-search",
            "gcp-production",
            "azure-production",
            "hetzner-production",
            "other-cloud-production",
            "general-availability",
            "compliance-certification",
            "grpc-credential-injection",
            "non-http-egress"
          ]
        },
        "status": { "const": "unsupported-unadvertised" },
        "advertised": { "const": false },
        "evidence_binding_sha256": { "type": "null" },
        "reason_code": {
          "enum": [
            "deferred-issue-13",
            "outside-mvp-scope",
            "other-cloud-not-validated",
            "release-not-established",
            "compliance-not-claimed"
          ]
        }
      }
    },
    "environmentProfile": {
      "enum": [
        "local-static",
        "linux-kvm",
        "eks-kata-release-candidate",
        "eks-kata-release-load",
        "independent-review-exact-release-candidate",
        "independent-zero-inventory",
        "staff-release-decision"
      ]
    },
    "evidenceContract": {
      "enum": [
        "future-local-test-reference-v1",
        "future-eks-conformance-reference-v1",
        "future-provider-real-model-reference-v1",
        "future-load-reference-v1",
        "future-independent-review-reference-v1",
        "future-privacy-deletion-reference-v1",
        "future-operations-reference-v1",
        "future-zero-inventory-reference-v1",
        "future-release-decision-reference-v1",
        "future-acceptance-index-reference-v1"
      ]
    },
    "criterionMapping": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 17,
      "required": [
        "id",
        "source_document",
        "source_section",
        "source_ordinal",
        "source_locator",
        "source_text_sha256",
        "accountable_owner_role",
        "accountable_principal_id",
        "environment_profile",
        "evidence_lane",
        "evidence_contract",
        "dependencies",
        "blocker",
        "applicability",
        "execution",
        "evidence_binding_sha256",
        "release_eligible"
      ],
      "properties": {
        "id": { "type": "string", "maxLength": 32, "pattern": "^(DESIGN-24|STAGE5-45)\\.[0-9]{2}$" },
        "source_document": { "enum": ["DESIGN.md", "IMPLEMENTATION.md"] },
        "source_section": { "enum": ["24", "45"] },
        "source_ordinal": { "type": "integer", "minimum": 1, "maximum": 22 },
        "source_locator": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(DESIGN.md#24\\.[0-9]+|IMPLEMENTATION.md#45\\.[0-9]+)$"
        },
        "source_text_sha256": { "$ref": "#/$defs/sha256" },
        "accountable_owner_role": { "$ref": "#/$defs/principalRole" },
        "accountable_principal_id": { "type": "null" },
        "environment_profile": { "$ref": "#/$defs/environmentProfile" },
        "evidence_lane": {
          "enum": ["local-test", "independent-review", "separately-approved-campaign", "staff-decision"]
        },
        "evidence_contract": { "$ref": "#/$defs/evidenceContract" },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" }
        },
        "blocker": {
          "enum": [
            "release-candidate-binding-not-present",
            "s4-11-not-accepted",
            "independent-identities-not-present",
            "campaign-approval-not-present",
            "provider-real-evidence-not-present",
            "stage5-evidence-not-present",
            "staff-decision-not-present"
          ]
        },
        "applicability": {
          "enum": [
            "mandatory-api-key-release",
            "mandatory-api-key-disabled-oauth-branch",
            "conditional-advertised-concurrency"
          ]
        },
        "execution": { "const": "unexecuted-by-this-draft" },
        "evidence_binding_sha256": { "type": "null" },
        "release_eligible": { "const": false }
      }
    },
    "evidenceReferenceSet": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/evidenceReference" }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 13,
      "required": [
        "criterion_id",
        "artifact_sha256",
        "declared_bytes",
        "media_type",
        "evidence_contract",
        "profile",
        "source_revision",
        "release_candidate_binding_sha256",
        "producer_role",
        "producer_principal_id",
        "producer_identity_binding_sha256",
        "result",
        "diagnostic_code"
      ],
      "properties": {
        "criterion_id": { "type": "string", "maxLength": 32, "pattern": "^(DESIGN-24|STAGE5-45)\\.[0-9]{2}$" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "declared_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "media_type": {
          "enum": ["application/json", "text/markdown", "application/spdx+json", "application/vnd.cyclonedx+json"]
        },
        "evidence_contract": { "$ref": "#/$defs/evidenceContract" },
        "profile": { "$ref": "#/$defs/environmentProfile" },
        "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "release_candidate_binding_sha256": { "$ref": "#/$defs/sha256" },
        "producer_role": { "$ref": "#/$defs/principalRole" },
        "producer_principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
        },
        "producer_identity_binding_sha256": { "$ref": "#/$defs/sha256" },
        "result": { "enum": ["pass", "fail", "uncertain"] },
        "diagnostic_code": {
          "enum": [
            "none",
            "assertion-failed",
            "dependency-unavailable",
            "cleanup-uncertain",
            "identity-unverified",
            "evidence-stale",
            "evidence-malformed"
          ]
        }
      }
    }
  }
}
