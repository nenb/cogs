{ "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogs.invalid/schemas/stage2-workload-local-qualification-v3.json",
  "title": "ADR 0099 non-authoritative local Kata qualification report data",
  "type": "object", "additionalProperties": false, "minProperties": 16, "maxProperties": 16,
  "properties": { "version": { "const": "cogs.stage2-workload-local-qualification/v3" },
    "result": { "enum": ["pass", "failure"] }, "failure_code": { "$ref": "#/$defs/nullableFailureCode" },
    "qualified": { "type": "boolean" }, "authority": { "const": "non-authoritative-local-qualification-report-data" },
    "validation_classification": { "const": "schema-insufficient-independent-semantics-and-private-receipt-required" },
    "limitations": { "const": [ "report-data-does-not-establish-local-qualification-authority",
      "requires-exact-private-receipt-and-custody-validation",
      "not-aws-evidence", "not-production-evidence", "not-release-evidence",
      "no-seven-cycle-controller-authority", "no-retry-or-promotion-authority" ] },
    "bindings": { "$ref": "#/$defs/bindings" }, "admission": { "$ref": "#/$defs/admission" },
    "platform": { "$ref": "#/$defs/platform" }, "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "operation": { "$ref": "#/$defs/operation" }, "timings": { "$ref": "#/$defs/timingGroups" },
    "timing_summaries": { "$ref": "#/$defs/timingSummaries" }, "teardown": { "$ref": "#/$defs/teardownRows" },
    "zero_residue": { "$ref": "#/$defs/zeroResidue" } },
  "oneOf": [ { "properties": { "result": { "const": "pass" },
        "failure_code": { "type": "null" }, "qualified": { "const": true }, "platform": { "$ref": "#/$defs/platformPass" },
        "lifecycle": { "$ref": "#/$defs/lifecyclePass" },
        "operation": { "type": "object", "properties": { "status": { "const": "retired" } } },
        "timings": { "$ref": "#/$defs/timingGroupsPass" },
        "teardown": { "type": "array", "items": { "$ref": "#/$defs/teardownRowPass" } },
        "zero_residue": { "$ref": "#/$defs/zeroResiduePass" }, "admission": { "$ref": "#/$defs/admissionPass" } } },
    { "properties": { "result": { "const": "failure" },
        "failure_code": { "$ref": "#/$defs/failureCode" }, "qualified": { "const": false } } } ],
  "$defs": { "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
    "failureCode": { "enum": [ "preflight", "source-binding", "attestation", "kvm", "lifecycle-start",
      "ssh", "git-sample", "build-sample", "install-sample", "deletion", "cleanup", "residue", "uncertain" ] },
    "nullableFailureCode": { "anyOf": [ { "type": "null" }, { "$ref": "#/$defs/failureCode" }
    ] }, "outcome": { "enum": ["pass", "failure", "not-reached"] },
    "duration": { "type": "integer", "minimum": 1, "maximum": 3600000000000 },
    "nullableDuration": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/duration" }] },
    "bindings": { "type": "object", "additionalProperties": false,
      "minProperties": 10, "maxProperties": 10,
      "propertyNames": { "enum": [ "source_head", "source_manifest_sha256", "host_attestation_sha256",
        "runtime_attestation_sha256", "rootfs_sha256", "artifact_sha256",
        "candidate_sha256", "final_pin_sha256", "guest_program_sha256", "owner_implementation_sha256" ] },
      "properties": { "source_head": { "$ref": "#/$defs/sha1" } },
      "patternProperties": { "_sha256$": { "$ref": "#/$defs/sha256" } } },
    "platform": { "type": "object", "additionalProperties": false,
      "required": ["observation", "kvm_api", "qmp_present", "qmp_enabled"],
      "properties": { "kvm_api": { "anyOf": [{ "type": "null" }, { "const": 12 }] },
        "qmp_present": { "type": "boolean" }, "qmp_enabled": { "type": "boolean" },
        "observation": { "$ref": "#/$defs/outcome" } } },
    "platformPass": { "const": { "kvm_api": 12, "qmp_present": true, "qmp_enabled": true, "observation": "pass"
    } }, "lifecycle": { "type": "object", "additionalProperties": false,
      "required": ["attempts", "outcome", "ssh_attempts", "ssh_outcome"],
      "properties": { "attempts": { "type": "integer", "minimum": 0, "maximum": 1 },
        "outcome": { "$ref": "#/$defs/outcome" }, "ssh_attempts": { "type": "integer", "minimum": 0, "maximum": 1 },
        "ssh_outcome": { "$ref": "#/$defs/outcome" } } },
    "lifecyclePass": { "const": { "attempts": 1, "outcome": "pass", "ssh_attempts": 1, "ssh_outcome": "pass"
    } }, "operation": { "type": "object", "additionalProperties": false,
      "minProperties": 7, "maxProperties": 7, "properties": { "operation_sha256": { "$ref": "#/$defs/nullableSha256" },
        "journal_sha256": { "$ref": "#/$defs/nullableSha256" }, "binding_sha256": { "$ref": "#/$defs/nullableSha256" },
        "source_head": { "$ref": "#/$defs/sha1" }, "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "final_pin_sha256": { "$ref": "#/$defs/sha256" }, "status": { "enum": ["not-created", "uncertain", "retired"] } },
      "if": { "type": "object", "properties": { "status": { "const": "not-created" } }
      },
      "then": { "type": "object", "properties": { "operation_sha256": { "type": "null" }, "journal_sha256": { "type": "null" },
        "binding_sha256": { "type": "null" } } },
      "else": { "type": "object", "properties": { "operation_sha256": { "$ref": "#/$defs/sha256" },
        "journal_sha256": { "$ref": "#/$defs/sha256" }, "binding_sha256": { "$ref": "#/$defs/sha256" }
      } } },
    "timingRow": { "type": "object", "additionalProperties": false,
      "required": ["ordinal", "duration_ns", "outcome", "deletion", "binding_sha256"],
      "properties": { "ordinal": { "type": "integer", "minimum": 1, "maximum": 7 },
        "duration_ns": { "$ref": "#/$defs/nullableDuration" }, "outcome": { "$ref": "#/$defs/outcome" },
        "deletion": { "enum": ["absent", "not-proved", "not-reached"] },
        "binding_sha256": { "$ref": "#/$defs/nullableSha256" } } },
    "timingRowPass": { "type": "object",
      "properties": { "outcome": { "const": "pass" },
        "deletion": { "const": "absent" }, "duration_ns": { "$ref": "#/$defs/duration" },
        "binding_sha256": { "$ref": "#/$defs/sha256" } } },
    "timingGroupObject": { "type": "object", "minProperties": 3, "maxProperties": 3,
      "propertyNames": { "enum": ["git", "build", "install"] } },
    "timingGroups": { "allOf": [
      { "$ref": "#/$defs/timingGroupObject" }, { "type": "object", "additionalProperties": { "$ref": "#/$defs/timingRows" } } ] },
    "timingGroupsPass": { "allOf": [
      { "$ref": "#/$defs/timingGroupObject" }, { "type": "object", "additionalProperties": { "$ref": "#/$defs/timingRowsPass" } } ] },
    "timingRowsPass": { "type": "array", "minItems": 7, "maxItems": 7,
      "items": { "$ref": "#/$defs/timingRowPass" } },
    "timingSummary": { "type": "object", "additionalProperties": false,
      "required": ["count", "total_ns", "minimum_ns", "maximum_ns"],
      "properties": { "count": { "type": "integer", "minimum": 0, "maximum": 7 },
        "total_ns": { "type": "integer", "minimum": 0, "maximum": 25200000000000 },
        "minimum_ns": { "$ref": "#/$defs/nullableDuration" }, "maximum_ns": { "$ref": "#/$defs/nullableDuration" } } },
    "timingSummaries": { "allOf": [
      { "$ref": "#/$defs/timingGroupObject" }, { "type": "object", "additionalProperties": { "$ref": "#/$defs/timingSummary" } } ] },
    "teardownRow": { "type": "object", "additionalProperties": false,
      "required": ["phase", "outcome", "binding_sha256"], "properties": { "phase": { "type": "string" },
        "outcome": { "$ref": "#/$defs/outcome" }, "binding_sha256": { "$ref": "#/$defs/nullableSha256" } } },
    "teardownRowPass": { "type": "object", "properties": { "outcome": { "const": "pass" }, "binding_sha256": { "$ref": "#/$defs/sha256" }
    } }, "absence": { "enum": ["absent", "not-proved"] },
    "residueObject": { "type": "object", "minProperties": 37, "maxProperties": 37,
      "propertyNames": { "enum": [ "tasks", "containers", "shim_processes", "qemu_processes",
          "virtiofsd_processes", "containerd_processes", "child_processes", "cgroups",
          "namespaces", "veth_devices", "tap_devices", "traffic_control", "firewall",
          "shares", "mounts", "inputs", "operation_state", "runtime_state",
          "runtime_cache", "rootfs_lease", "rootfs_build", "rootfs_publication",
          "unexpected_descriptors", "network_state", "network_routes", "network_addresses",
          "firewall_baseline", "mount_baseline", "source_identity", "input_control",
          "share_paths", "runtime_staging", "report_staging", "descriptor_baseline",
          "process_baseline", "cgroup_baseline", "namespace_baseline"
        ] } },
    "zeroResidue": { "allOf": [ { "$ref": "#/$defs/residueObject" }, { "type": "object", "additionalProperties": { "$ref": "#/$defs/absence" } }
    ] },
    "zeroResiduePass": { "allOf": [ { "$ref": "#/$defs/residueObject" }, { "type": "object", "additionalProperties": { "const": "absent" } }
    ] }, "admissionObject": { "type": "object", "minProperties": 4, "maxProperties": 4,
      "propertyNames": { "enum": ["preflight", "source_binding", "attestation", "kvm"] } },
    "admission": { "allOf": [ { "$ref": "#/$defs/admissionObject" }, { "type": "object", "additionalProperties": { "$ref": "#/$defs/outcome" } }
    ] }, "admissionPass": { "const": { "preflight": "pass", "source_binding": "pass", "attestation": "pass", "kvm": "pass"
    } }, "timingRows": { "type": "array", "minItems": 7, "maxItems": 7,
      "prefixItems": [ { "$ref": "#/$defs/timingRow", "type": "object", "properties": { "ordinal": { "const": 1 } } },
        { "$ref": "#/$defs/timingRow", "type": "object", "properties": { "ordinal": { "const": 2 } } },
        { "$ref": "#/$defs/timingRow", "type": "object", "properties": { "ordinal": { "const": 3 } } },
        { "$ref": "#/$defs/timingRow", "type": "object", "properties": { "ordinal": { "const": 4 } } },
        { "$ref": "#/$defs/timingRow", "type": "object", "properties": { "ordinal": { "const": 5 } } },
        { "$ref": "#/$defs/timingRow", "type": "object", "properties": { "ordinal": { "const": 6 } } },
        { "$ref": "#/$defs/timingRow", "type": "object", "properties": { "ordinal": { "const": 7 } } } ],
      "items": false },
    "teardownRows": { "allOf": [ { "type": "array",
          "minItems": 13, "maxItems": 13, "items": { "$ref": "#/$defs/teardownRow" } },
        { "type": "array",
          "minItems": 13, "maxItems": 13,
          "prefixItems": [ { "type": "object", "properties": { "phase": { "const": "READINESS_REVOKED" } } },
            { "type": "object", "properties": { "phase": { "const": "TASK_STOPPED" } } },
            { "type": "object", "properties": { "phase": { "const": "TASK_ABSENT" } } },
            { "type": "object", "properties": { "phase": { "const": "RUNTIME_PROCESSES_ABSENT" } } },
            { "type": "object", "properties": { "phase": { "const": "NETWORK_ABSENT" } } },
            { "type": "object", "properties": { "phase": { "const": "CONTAINER_ABSENT" } } },
            { "type": "object", "properties": { "phase": { "const": "SHARE_AND_MOUNTS_ABSENT" } } },
            { "type": "object", "properties": { "phase": { "const": "FIREWALL_ABSENT" } } },
            { "type": "object", "properties": { "phase": { "const": "CONTAINERD_ABSENT" } } },
            { "type": "object", "properties": { "phase": { "const": "INPUTS_ABSENT" } } },
            { "type": "object", "properties": { "phase": { "const": "ROOTFS_ABSENT" } } },
            { "type": "object", "properties": { "phase": { "const": "FINAL_BASELINES" } } },
            { "type": "object", "properties": { "phase": { "const": "RETIRED" } } } ],
          "items": false } ] },
    "platformUnobserved": { "const": { "kvm_api": null, "qmp_present": false, "qmp_enabled": false, "observation": "not-reached"
    } }, "kvmPassFields": { "type": "object", "required": ["kvm_api", "qmp_present", "qmp_enabled"],
      "properties": { "kvm_api": { "const": 12 },
        "qmp_present": { "const": true }, "qmp_enabled": { "const": true } } },
    "platformFailure": { "type": "object", "properties": { "observation": { "const": "failure" } },
      "not": { "$ref": "#/$defs/kvmPassFields" } },
    "admissionKvmPass": { "type": "object", "properties": { "kvm": { "const": "pass" } } },
    "admissionKvmFailure": { "type": "object", "properties": { "kvm": { "const": "failure" } } },
    "admissionKvmNotReached": { "type": "object", "properties": { "kvm": { "const": "not-reached" } } } },
  "allOf": [ { "oneOf": [ { "properties": { "admission": { "$ref": "#/$defs/admissionKvmPass" },
            "platform": { "$ref": "#/$defs/platformPass" } } },
        { "properties": { "admission": { "$ref": "#/$defs/admissionKvmFailure" },
            "platform": { "$ref": "#/$defs/platformFailure" } } },
        { "properties": { "admission": { "$ref": "#/$defs/admissionKvmNotReached" },
            "platform": { "$ref": "#/$defs/platformUnobserved" } } }
      ] }
  ] }
