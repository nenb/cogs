{
  "version": "cogs.outcome-two-recovery-cases/v2",
  "worker_crash_cuts": [
    "worker.registered",
    "descriptor.intent",
    "descriptor.settled",
    "child.intent",
    "child.registered",
    "child.released",
    "namespace.intent",
    "namespace.settled",
    "mount.intent",
    "mount.settled",
    "report.intent",
    "report.sealed",
    "issuer.intent",
    "issuer.sent"
  ],
  "terminal_uncertainty": [
    "worker-pidfd-lost",
    "worker-start-time-drift",
    "child-pidfd-lost",
    "child-start-time-drift",
    "child-executable-drift",
    "unknown-descendant",
    "namespace-handle-lost",
    "foreign-mount",
    "reap-timeout",
    "cleanup-close-uncertain"
  ],
  "handoff_cuts": ["issue.before-revalidate", "issue.before-transfer"],
