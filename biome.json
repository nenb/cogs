{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.cogs-dev",
      "!!node_modules",
      "!!package-lock.json",
      "!!LICENSE",
      "!!deploy/aws-feasibility/.state"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": [
        "schemas/native-qualification-report-v1alpha1.json",
        "scripts/validate-schemas.ts",
        "test/native-qualification-b.test.ts",
        "test/native-qualification-common.test.ts",
        "test/native-qualification-e.test.ts",
        "test/native-qualification-integration.test.ts"
      ],
      "formatter": {
        "enabled": false
      }
    }
  ]
}
