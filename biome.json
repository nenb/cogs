{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.cogs-dev",
      "!!node_modules",
      "!!package-lock.json",
      "!!LICENSE",
      "!!deploy/aws-feasibility/.state"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": [
        "schemas/native-qualification-report-v1alpha1.json",
        "docs/security-evidence/stage4-offline-readiness-package.json",
        "docs/security-evidence/stage4-offline-readiness-artifacts/*.json",
        "docs/security-evidence/release-image-set-*.canonical.json",
        "docs/security-evidence/stage5-privacy-deletion.local-static.json",
        "docs/security-evidence/stage5-offline-preparation/*.json",
        "test/fixtures/stage4-static-manifest/valid-request-v1.json",
        "test/fixtures/stage5-privacy/valid-suite-v1.json",
        "test/fixtures/stage2-completion/local-result-v2-*.json",
        "test/fixtures/stage2-completion/attested-*-contract-v1.json",
        "config/stage2-completion-ssh-workload-v2.json",
        "schemas/stage2-workload-local-qualification-v2.json",
        "schemas/stage2-workload-candidate-v2.json",
        "deploy/aws-feasibility/remote/stage2-completion-runtime-v1.json",
        "scripts/validate-schemas.ts",
        "test/native-qualification-b.test.ts",
        "test/native-qualification-common.test.ts",
        "test/native-qualification-e.test.ts",
        "test/native-qualification-integration.test.ts"
      ],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
