{
  "name": "@nenb/cogs",
  "version": "0.0.0",
  "private": true,
  "description": "Secure, minimal, VM-isolated personal assistant built on Pi",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run release-pins:check && npm run test && npm run schemas && npm run presets:check && npm run egress-bindings:check && npm run images:check && npm run lock:check && npm run licenses && npm run audit",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "test:pi": "tsx --test test/pi-embedding.test.ts",
    "test:pi:real-provider": "tsx scripts/pi-real-provider-integration.ts",
    "schemas": "tsx scripts/validate-schemas.ts",
    "presets:check": "tsx scripts/validate-presets.ts",
    "egress-bindings:check": "tsx scripts/check-envoy-ext-authz-descriptor.ts --static",
    "egress-bindings:regenerate-check": "tsx scripts/check-envoy-ext-authz-descriptor.ts --regenerate",
    "feasibility-source:check": "tsx scripts/check-feasibility-source.ts",
    "images:check": "tsx scripts/check-image-pins.ts",
    "release-pins:check": "tsx scripts/release-image-set-pins-cli.ts check",
    "release-pins:regenerate": "tsx scripts/release-image-set-pins-cli.ts write",
    "images:local:verify": "tsx scripts/local-image-artifacts-cli.ts",
    "images:local:assemble": "tsx scripts/assemble-local-image-artifact-package.ts",
    "lock:check": "tsx scripts/check-lock-integrity.ts",
    "licenses": "tsx scripts/check-licenses.ts",
    "audit": "tsx scripts/check-npm-audit.ts",
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "evidence:issue68": "tsx scripts/benchmark-issue68-checkpoints.ts",
    "readiness:regenerate": "node scripts/stage4-offline-readiness-regenerate.ts",
    "readiness:render:check": "node scripts/stage4-offline-render-preparation.ts",
    "readiness:production:check": "tsx --test --test-concurrency=1 test/api-server.test.ts test/local-image-artifacts.test.ts test/openbao-workload-identity.test.ts test/production-compose.test.ts test/production-sandbox-image.test.ts test/production-worker-image.test.ts test/release-image-set-assertion.test.ts test/runtime-config.test.ts test/runtime-trusted-files.test.ts test/stage4-nic-sandbox-node-group-v2.test.ts test/stage4-static-manifest-package.test.ts",
    "readiness:source:check": "node scripts/stage4-offline-source-inventory.ts",
    "stage4:manifests": "node scripts/stage4-static-manifest-package.ts",
    "launcher": "tsx dev/launcher/main.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "brace-expansion": "5.0.8",
    "ssh2": "1.17.0",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "22.20.1",
    "@types/ssh2": "1.15.5",
    "tsx": "4.23.0",
    "typescript": "5.9.3"
  }
}
